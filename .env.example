#==========================================================================

# Deliveroo.js
#==========================================================================
HOST="http://localhost:8080/"
TOKEN=""


#==========================================================================

# PAAS
#==========================================================================
PAAS_HOST="http://localhost:5001"
PAAS_PATH="/package/optic/solve"
#PAAS_PATH='/package/dual-bfws-ffparser/solve'
#PAAS_PATH='/package/lama-first/solve'

# PAAS_HOST='https://solver.planning.domains:5001'  // default
# PAAS_HOST='https://paas-uom.org:5001'
# PAAS_HOST='http://localhost:5001'                 // when running locally https://github.com/AI-Planning/planning-as-a-service

# The API path on the planning-as-a-service server
# PAAS_PATH='/package/dual-bfws-ffparser/solve'     // default
# PAAS_PATH='/package/delfi/solve'
# PAAS_PATH='/package/enhsp-2020/solve'
# PAAS_PATH='/package/forbiditerative-topk/solve'   // PARSING NOT SUPPORTED YET
# PAAS_PATH='/package/lama-first/solve'             // PARSING NOT SUPPORTED YET
# PAAS_PATH='/package/optic/solve'
# PAAS_PATH='/package/tfd/solve'                    // PARSING NOT SUPPORTED YET%


#==========================================================================

#LiteLLM
#==========================================================================
LLM_TARGET=local
#LLM_TARGET=remote

PREFLIGHT_ALL_LLM_MODELS=false

# --- Local (LiteLLM proxy → Ollama) ---
LOCAL_BASE_URL=http://localhost:4000
LOCAL_API_KEY=sk-local-dev
LOCAL_MODEL=local/gemma4:12b


# --- Remote ---
REMOTE_BASE_URL=https://llm.bears.disi.unitn.it
REMOTE_API_KEY=""
REMOTE_MODEL=gpt-4o

# --- LLM_Agent request options (optional, both have working defaults) ---
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.9


#==========================================================================
#**************************************************************************
# AGENT CONFIGURATION
#**************************************************************************
#==========================================================================
MAX_AGENT_HISTORY_POSITIONS=20
DESIRES_GENERATION_BACKSTOP_TIMER_MS=1000
PDDL_PATHFINDIG_MAX_SOLVING_TIME_S=6

ENABLE_TERMINAL_UI=true
SHOW_GRID_MAP_IN_UI=true
SHOW_HEATMAP_IN_UI=false


